# LLM Configuration (provider-agnostic)
CHAT_MODEL=gpt-4o
CHAT_MODEL_PROVIDER=openai
CHAT_MODEL_API_KEY=sk-...
CHAT_MODEL_BASE_URL=
CHAT_MODEL_SUPPORTS_VISION=

# Background memory extraction (independent model; enable after choosing a provider/model)
SESSION_MEMORY_ENABLED=false
LONG_TERM_MEMORY_ENABLED=false
MEMORY_INJECTION_ENABLED=true
SESSION_MEMORY_INJECTION_MAX_CHARS=6000
LONG_TERM_MEMORY_INJECTION_MAX_CHARS=6000
MEMORY_INJECTION_MAX_CHARS=13000
MEMORY_MODEL=
MEMORY_MODEL_PROVIDER=
MEMORY_MODEL_API_KEY=
MEMORY_MODEL_BASE_URL=
MEMORY_TIMEOUT_SECONDS=30
MEMORY_OUTPUT_TOKENS=4096
MEMORY_INPUT_CHARS=48000
MEMORY_WORKERS=2
MEMORY_MAX_ATTEMPTS=3
SESSION_MEMORY_INITIAL_TOKENS=10000
SESSION_MEMORY_STEP_TOKENS=5000
SESSION_MEMORY_MAX_CHARS=16000
LONG_TERM_MEMORY_MAX_CHARS=24000
LONG_TERM_MEMORY_DEBOUNCE_SECONDS=30
LONG_TERM_MEMORY_MAX_DELAY_SECONDS=300
MEMORY_CONFIDENCE_THRESHOLD=0.7
MEMORY_MAX_FACTS=100
# Leave unset for Aegra. Only trusted standalone single-user graphs may set this.
# MEMORY_STANDALONE_OWNER=local-user

# Container Limits
CONTAINER_MEMORY_LIMIT=1024m
CONTAINER_CPU_QUOTA=50000
CONTAINER_PIDS_LIMIT=128
CONTAINER_TMPFS_SIZE=200m
CONTAINER_EXECUTION_TIMEOUT_SECONDS=30
CONTAINER_MAX_SESSIONS=5
CONTAINER_MAX_SESSIONS_PER_THREAD=3
CONTAINER_EXECUTE_AS_ROOT=False

# Session Lifecycle (GC)
SESSION_IDLE_TTL_SECONDS=600
SESSION_MAX_LIFETIME_SECONDS=7200
SESSION_GC_INTERVAL_SECONDS=60
# Legacy setting; warm-pool admission now uses CONTAINER_MAX_SESSIONS.
SESSION_MAX_ACTIVE_THREADS=10
SANDBOX_LEASE_TTL_SECONDS=120
SANDBOX_QUEUE_TIMEOUT_SECONDS=30
SANDBOX_MAX_WAITERS=16
# Only for trusted standalone single-user graphs, leave unset for Aegra:
# SANDBOX_STANDALONE_OWNER=local-user
CONTAINER_TERMINAL_TIMEOUT_SECONDS=300
CONTAINER_INSTALL_TIMEOUT_SECONDS=600

# Output Limits
MAX_STDOUT_CHARS=50000
MAX_STDERR_CHARS=20000
MAX_RESULT_CHARS=30000
MAX_TRACEBACK_CHARS=8000

# Encryption (Fernet key — run `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` to generate)
ENCRYPTION_KEY=

# Storage
STORAGE_DIR=./storage
IMPORT_ALLOWED_DIRS=

# API
API_BASE_URL=http://127.0.0.1:8000

# Agent
MAX_ITERATIONS=100

# Agent tool safety (no AI reviewer; MCP server is outside this feature)
# Host commands run on the Windows machine and require confirmation every time.
HOST_COMMANDS_ENABLED=false
HOST_COMMAND_TIMEOUT_SECONDS=60
HOST_COMMAND_MAX_TIMEOUT_SECONDS=300
TOOL_APPROVAL_TTL_SECONDS=1800
TOOL_MAX_CONCURRENCY=4
# Main graph step budget, including middleware hooks (not model turns).
AGENT_MAX_STEPS=1000
# Independent Aegra workers with isolated sandboxes and checkpoint approvals.
SUBAGENTS_ENABLED=true
SUBAGENT_MAX_CONCURRENCY=3
SUBAGENT_MAX_TASKS_PER_RUN=12
SUBAGENT_TIMEOUT_SECONDS=900
SUBAGENT_MAX_STEPS=80
# Optional internal Agent Protocol URL. Defaults to API_BASE_URL/internal/subagents.
SUBAGENT_PROTOCOL_URL=
# JSON list; precedence: deny > ask > allow > tool default. cwd matches the starting directory,
# NOT the filesystem reach of arbitrary PowerShell. Restart after changing rules.
TOOL_SECURITY_RULES=[]
# Example: TOOL_SECURITY_RULES=[{"effect":"deny","tool":"execute_terminal"}]
# Approval test: TOOL_SECURITY_RULES=[{"effect":"ask","tool":"execute_terminal"}]

# Persistent context compaction (explicit model windows required when enabled).
# See docs/CONTEXT_COMPACTION.md. Shares MEMORY_MODEL / MEMORY_MODEL_PROVIDER.
CONTEXT_COMPACTION_ENABLED=false
CONTEXT_MODEL_WINDOWS={"gpt-4o":128000}
CONTEXT_OUTPUT_RESERVE=8192
CONTEXT_SAFETY_TOKENS=2048
CONTEXT_TRIGGER_RATIO=0.8
CONTEXT_TARGET_RATIO=0.5
CONTEXT_KEEP_MESSAGES=6

# Aegra + Checkpointer (PostgreSQL)
AEGRA_CONFIG=langgraph.json
AUTH_TYPE=noop
POSTGRES_USER=taskharbor
POSTGRES_PASSWORD=taskharbor_secret
POSTGRES_DB=taskharbor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
